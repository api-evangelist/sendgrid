    "_postman_id": "60c3615e-1f65-4950-9f31-d230b11d6f41",
    "name": "Twilio SendGrid Marketing Campaigns Send Test Email API",
    "description": "The Twilio SendGrid Test Email API allows you to test a marketing email by first sending it to a list of up to 10 email addresses before pushing to a contact list or segment. With this feature, you can test the layout and content of your message in multiple email clients and with multiple recipients to see how it will function in a real-world scenario.\n\nContact Support:\n Name: Twilio SendGrid Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:17:38.000Z",
    "updatedAt": "2026-06-05T15:17:38.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-60c3615e-1f65-4950-9f31-d230b11d6f41"
  },
