{
  "info": {
    "_postman_id": "a1d4b3e8-2ea5-4222-91da-e52f721ee677",
    "name": "Twilio SendGrid Recipients' Data Erasure API",
    "description": "The Recipients' Data Erasure API allows Twilio SendGrid customers to delete their own customers' personal data from the Twilio SendGrid Platform. The use of this API facilitates the self-service removal of email personal data from the Twilio SendGrid platform and will enable customers to comply with various obligatory data privacy regulations.\n\nContact Support:\n Name: Twilio SendGrid Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:17:40.000Z",
    "updatedAt": "2026-06-05T15:17:40.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-a1d4b3e8-2ea5-4222-91da-e52f721ee677"
  },
