{
  "info": {
    "_postman_id": "6b4a02ec-c57c-41b5-8168-227e5c38c153",
    "name": "Twilio SendGrid Alerts API",
    "description": "The Twilio SendGrid Alerts API allows you to specify an email address to receive notifications regarding your email usage or statistics. You can set up alerts to be sent to a specific email address on a recurring basis, whether for informational purposes or when specific account actions occur.\n\nFor most alerts, you can choose to have the alert sent to you as needed, hourly, daily, weekly, or monthly. The information contained in your alert will be for the last period of the alert. For example, if you choose weekly for the statistics alert, you will receive the statistics for the last week.\n\nContact Support:\n Name: Twilio SendGrid Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:16:30.000Z",
    "updatedAt": "2026-06-05T15:16:31.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-6b4a02ec-c57c-41b5-8168-227e5c38c153"
  },
