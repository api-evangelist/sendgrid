        {
          "id": "d9a36489-530d-49bb-b240-76983bd99c3d",
          "name": "Retrieve Email Statistics for Categories",
          "request": {
            "name": "Retrieve Email Statistics for Categories",
            "description": {
              "content": "**This endpoint allows you to retrieve all of your email statistics for each of your categories.**\n\nIf you do not define any query parameters, this endpoint will return a sum for each category in groups of 10.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "categories",
                "stats"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<string>",
                  "description": "(Required) The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<string>",
                  "description": "The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD."
                },
                {
                  "disabled": false,
                  "key": "categories",
                  "value": "<string>",
                  "description": "(Required) The individual categories that you want to retrieve statistics for. You may include up to 10 different categories."
                },
                {
                  "disabled": false,
                  "key": "aggregated_by",
                  "value": "<string>",
                  "description": "How to group the statistics. Must be either \"day\", \"week\", or \"month\"."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "The `on-behalf-of` header allows you to make API calls from a parent account on behalf of the parent's Subusers or customer accounts. You will use the parent account's API key when using this header. When making a call on behalf of a customer account, the property value should be \"account-id\" followed by the customer account's ID (e.g., `on-behalf-of: account-id <account-id>`). When making a call on behalf of a Subuser, the property value should be the Subuser's username (e.g., `on-behalf-of: <subuser-username>`). See [**On Behalf Of**](https://docs.sendgrid.com/api-reference/how-to-use-the-sendgrid-v3-api/on-behalf-of) for more information.",
                "key": "on-behalf-of",
                "value": "<string>"
