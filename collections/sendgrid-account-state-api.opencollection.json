{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twilio SendGrid Provisioning Account Account State API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account State",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an account's state",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sendgrid.com/v3/partners/accounts/:accountID/state",
            "params": [
              {
                "name": "accountID",
                "value": "sg2a2bcd3ef4ab5c67d8efab91c01de2fa",
                "type": "path",
                "description": "Twilio SendGrid account ID"
              }
            ]
          },
          "docs": "Retrieve the state of the specified account."
        },
        {
          "info": {
            "name": "Update an account's state",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.sendgrid.com/v3/partners/accounts/:accountID/state",
            "params": [
              {
                "name": "accountID",
                "value": "sg2a2bcd3ef4ab5c67d8efab91c01de2fa",
                "type": "path",
                "description": "Twilio SendGrid account ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the state of the specified account."
        }
      ]
    }
  ],
  "bundled": true
}