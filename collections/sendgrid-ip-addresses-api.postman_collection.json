                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"ip\": \"192.168.1.1\",\n    \"pools\": [\n      \"pool1\",\n      \"pool2\"\n    ],\n    \"whitelabeled\": false,\n    \"start_date\": 1409616000,\n    \"subusers\": [\n      \"tim@sendgrid.net\"\n    ],\n    \"warmup\": false,\n    \"assigned_at\": 1482883200\n  },\n  {\n    \"ip\": \"208.115.214.22\",\n    \"pools\": [],\n    \"whitelabeled\": true,\n    \"rdns\": \"o1.email.example.com\",\n    \"start_date\": 1409616000,\n    \"subusers\": [],\n    \"warmup\": false,\n    \"assigned_at\": 1482883200\n  }\n]",
