        {
          "id": "849c883a-bf26-4041-ba7c-7dec06207ab8",
          "name": "Retrieve all IP pools an IP address belongs to",
          "request": {
            "name": "Retrieve all IP pools an IP address belongs to",
            "description": {
              "content": "**This endpoint allows you to see which IP pools a particular IP address has been added to.**\n\nThe same IP address can be added to multiple IP pools.\n\nA single IP address or a range of IP addresses may be dedicated to an account in order to send email for multiple domains. The reputation of this IP is based on the aggregate performance of all the senders who use it.",
              "type": "text/plain"
            },
