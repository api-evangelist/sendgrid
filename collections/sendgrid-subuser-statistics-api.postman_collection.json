          "request": {
            "name": "Retrieve the monthly email statistics for a single subuser",
            "description": {
              "content": "**This endpoint allows you to retrive the monthly email statistics for a specific subuser.**\n\nWhen using the `sort_by_metric` to sort your stats by a specific metric, you can not sort by the following metrics:\n`bounce_drops`, `deferred`, `invalid_emails`, `processed`, `spam_report_drops`, `spam_reports`, or `unsubscribe_drops`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "subusers",
                ":subuser_name",
                "stats",
                "monthly"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<string>",
                  "description": "(Required) The date of the month to retrieve statistics for. Must be formatted YYYY-MM-DD"
                },
                {
                  "disabled": false,
                  "key": "sort_by_metric",
                  "value": "delivered",
                  "description": "The metric that you want to sort by. Metrics that you can sort by are: `blocks`, `bounces`, `clicks`, `delivered`, `opens`, `requests`, `unique_clicks`, `unique_opens`, and `unsubscribes`.'"
                },
                {
                  "disabled": false,
                  "key": "sort_by_direction",
                  "value": "desc",
                  "description": "The direction you want to sort."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "5",
                  "description": "Optional field to limit the number of results returned."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Optional beginning point in the list to retrieve from."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "subuser_name",
                  "description": "(Required) The username of the Subuser."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
