        {
          "id": "a1c5a082-103d-4468-92c1-4a3f5d868172",
          "name": "Request a presigned URL and headers for Bulk Email Address Validation list upload.",
          "request": {
            "name": "Request a presigned URL and headers for Bulk Email Address Validation list upload.",
            "description": {
              "content": "**This endpoint returns a presigned URL and request headers. Use this information to upload a list of email addresses for verification.**\n\nNote that in a successful response the `content-type` header value matches the provided `file_type` parameter in the `PUT` request.\n\nOnce you have an `upload_uri` and the `upload_headers`, you're ready to upload your email address list for verification. For the expected format of the email address list and a sample upload request, see the [Bulk Email Address Validation Overview page](https://www.twilio.com/docs/sendgrid/ui/managing-contacts/email-address-validation/bulk-email-address-validation-overview).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "validations",
                "email",
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_type\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "38711870-7a93-43a9-a0e0-9bacf760a678",
              "name": "The request was successful. The response contains the URI and headers where you will upload your email address list.",
